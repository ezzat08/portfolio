    <script>

      const carousels =
        document.querySelectorAll("[data-carousel]");


      carousels.forEach((carousel) => {

        const slides =
          carousel.querySelectorAll(".carousel-slide");

        const previous =
          carousel.querySelector("[data-prev]");

        const next =
          carousel.querySelector("[data-next]");

        const current =
          carousel.querySelector("[data-current]");

        let index = 0;


        function showSlide(newIndex: number) {

          index =
            (newIndex + slides.length) % slides.length;


          slides.forEach((slide, i) => {

            slide.classList.toggle(
              "active",
              i === index
            );

          });


          if (current) {

            current.textContent =
              String(index + 1).padStart(2, "0");

          }


          /*
           * HARDWARE CARD SYNC
           */

          if (
            carousel.classList.contains(
              "hardware-carousel"
            )
          ) {

            const hardwareCards =
              document.querySelectorAll(
                ".hardware-card"
              );


            hardwareCards.forEach((card) => {

              const cardIndex =
                Number(
                  card.getAttribute(
                    "data-hardware"
                  )
                );


              card.classList.toggle(
                "active",
                cardIndex === index
              );

            });

          }

        }


        previous?.addEventListener("click", () => {

          showSlide(index - 1);

        });


        next?.addEventListener("click", () => {

          showSlide(index + 1);

        });


        carousel.setAttribute(
          "tabindex",
          "0"
        );


        carousel.addEventListener("focus", () => {

          carousel.classList.add(
            "focused"
          );

        });


        carousel.addEventListener("blur", () => {

          carousel.classList.remove(
            "focused"
          );

        });


        if (
          carousel.classList.contains(
            "hardware-carousel"
          )
        ) {

          showSlide(0);

        }

      });


      /*
       * HARDWARE CARD CLICK
       */

      const hardwareCards =
        document.querySelectorAll(
          ".hardware-card"
        );


      const hardwareCarousel =
        document.querySelector(
          ".hardware-carousel"
        );


      hardwareCards.forEach((card) => {

        card.addEventListener(
          "click",
          () => {

            const hardwareIndex =
              Number(
                card.getAttribute(
                  "data-hardware"
                )
              );


            if (!hardwareCarousel) return;


            const slides =
              hardwareCarousel.querySelectorAll(
                ".carousel-slide"
              );


            const current =
              hardwareCarousel.querySelector(
                "[data-current]"
              );


            slides.forEach((slide, i) => {

              slide.classList.toggle(
                "active",
                i === hardwareIndex
              );

            });


            if (current) {

              current.textContent =
                String(
                  hardwareIndex + 1
                ).padStart(2, "0");

            }


            hardwareCards.forEach(
              (otherCard) => {

                const otherIndex =
                  Number(
                    otherCard.getAttribute(
                      "data-hardware"
                    )
                  );


                otherCard.classList.toggle(
                  "active",
                  otherIndex === hardwareIndex
                );

              }
            );

          }
        );

      });


      /*
       * KEYBOARD CONTROL
       */

      document.addEventListener(
        "keydown",
        (event) => {

          const activeCarousel =
            document.activeElement?.closest(
              "[data-carousel]"
            );


          if (!activeCarousel) return;


          const previous =
            activeCarousel.querySelector(
              "[data-prev]"
            );


          const next =
            activeCarousel.querySelector(
              "[data-next]"
            );


          if (event.key === "ArrowLeft") {

            previous?.dispatchEvent(
              new MouseEvent("click")
            );

          }


          if (event.key === "ArrowRight") {

            next?.dispatchEvent(
              new MouseEvent("click")
            );

          }

        }
      );

    </script>


