
---
import "../styles/global.css";

const projectName = "IoT-Enabled Smart Home";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="IoT-Enabled Smart Home — a connected system built with physical devices, distributed sections and software."
    />

    <title>{projectName} — Project Portfolio</title>
  </head>

  <body>

    <!-- =====================================================
         NAVBAR
    ====================================================== -->

    <nav class="navbar">
      <div class="nav-inner">

        <a href="/" class="nav-logo">
          IoT Security
        </a>

        <div class="nav-links">
          <a href="#system">System</a>
          <a href="#architecture">How It Works</a>
          <a href="#security">Security</a>
          <a href="#beyond">Beyond Security</a>
          <a href="#about">About</a>
        </div>

      </div>
    </nav>


    <main>

      <!-- ===================================================
           HERO
      ==================================================== -->

      <section class="hero">

        <div class="hero-glow"></div>

        <div class="hero-inner">

          <div class="hero-content">

            <div class="eyebrow">
              <span class="status-dot"></span>
              Final Year Project · UiTM
            </div>

            <h1>
              From Sensor
              <span>to Screen.</span>
            </h1>

            <p class="hero-description">
              A connected IoT system that brings physical devices,
              different areas and software together to create
              one complete system.
            </p>

            <div class="tech-list">
              <span>ESP32</span>
              <span>IoT</span>
              <span>MQTT</span>
              <span>Node-RED</span>
              <span>Flutter</span>
            </div>

            <a href="#system" class="primary-button">
              Explore the project
              <span>↓</span>
            </a>

          </div>


          <!-- HERO CAROUSEL -->

          <!--<div class="carousel hero-carousel" data-carousel>

            <div class="carousel-track">

              <div class="carousel-slide active">

                <div class="image-box">

                  <img
                    src="/images/hero-1.jpg"
                    alt="IoT Smart Home hardware setup"
                  />

                </div>

              </div>


              <div class="carousel-slide">

                <div class="image-box">

                  <img
                    src="/images/hero-2.jpg"
                    alt="IoT Smart Home sensors and devices"
                  />

                </div>

              </div>


              <div class="carousel-slide">

                <div class="image-box">

                  <img
                    src="/images/hero-3.jpg"
                    alt="IoT Smart Home system"
                  />

                </div>

              </div>

            </div>


            <div class="carousel-footer">

              <div class="carousel-counter">
                <span data-current>01</span>
                <span class="muted"> / 03</span>
              </div>

              <div class="carousel-buttons">

                <button data-prev aria-label="Previous image">
                  ←
                </button>

                <button data-next aria-label="Next image">
                  →
                </button>

              </div>

            </div>

          </div>-->

        </div>

      </section>


      <!-- ===================================================
           INTRO
      ==================================================== -->

      <section id="system" class="section">

        <div class="container">

          <div class="section-header">

            <div class="eyebrow-text">
              THE IDEA
            </div>

            <h2>
              It's not just a smart home.
            </h2>

            <p>
              The main idea was to connect the physical world
              with software, so information from different
              parts of the system can be seen and understood
              in one place.
            </p>

          </div>


          <div class="three-cards">

            <div class="feature-card large-number">

              <div class="number">01</div>

              <div class="card-icon">
                ◉
              </div>

              <h3>
                Sense
              </h3>

              <p>
                Devices observe what is happening
                around them.
              </p>

            </div>


            <div class="feature-card large-number">

              <div class="number">02</div>

              <div class="card-icon">
                ↔
              </div>

              <h3>
                Connect
              </h3>

              <p>
                Information moves between different
                parts of the system.
              </p>

            </div>


            <div class="feature-card large-number">

              <div class="number">03</div>

              <div class="card-icon">
                ✦
              </div>

              <h3>
                Understand
              </h3>

              <p>
                The information can then be used
                to understand what is happening.
              </p>

            </div>

          </div>

        </div>

      </section>


      <!-- ===================================================
           HARDWARE
      ==================================================== -->

      <section class="section section-dark">

        <div class="container">

          <div class="section-header">

            <div class="eyebrow-text">
              THE PHYSICAL SIDE
            </div>

            <h2>
              It starts with real hardware.
            </h2>

            <p>
              Before information reaches a screen,
              something in the real world has to detect it.
            </p>

          </div>


          <div class="hardware-layout">

            <!-- HARDWARE CAROUSEL -->

            <div class="carousel hardware-carousel" data-carousel>

              <div class="carousel-track">

                <div class="carousel-slide active">

                  <div class="image-box hardware-image-box">

                    <img
                      src="/images/esp32.png"
                      alt="Main ESP32 hardware"
                    />

                  </div>

                </div>


                <div class="carousel-slide">

                  <div class="image-box hardware-image-box">

                    <img
                      src="/images/combine.png"
                      alt="PIR and vibration sensors"
                    />

                  </div>

                </div>


                <div class="carousel-slide">

                  <div class="image-box hardware-image-box">

                    <img
                      src="/images/camera.png"
                      alt="ESP32-CAM"
                    />

                  </div>

                </div>

              </div>


              <div class="carousel-footer">

                <div class="carousel-counter">
                  <span data-current>01</span>
                  <span class="muted"> / 03</span>
                </div>

                <div class="carousel-buttons">

                  <button data-prev aria-label="Previous image">
                    ←
                  </button>

                  <button data-next aria-label="Next image">
                    →
                  </button>

                </div>

              </div>

            </div>


            <!-- HARDWARE CARDS -->

            <div class="hardware-list">

              <div
                class="simple-card hardware-card active"
                data-hardware="0"
              >

                <div class="card-top">

                  <span class="number">
                    01
                  </span>

                  <span class="small-tech">
                    ESP32
                  </span>

                </div>

                <h3>
                  Local Brain
                </h3>

                <p>
                  Each area has a small controller
                  that connects its devices to the system.
                </p>

              </div>


              <div
                class="simple-card hardware-card active-combined"
                data-hardware="1"
              >

                <div class="card-top">

                  <span class="number">
                    02
                  </span>

                  <span class="small-tech">
                    PIR
                  </span>

                </div>

                <h3>
                  Movement
                </h3>

                <p>
                  Detects movement in the monitored area.
                </p>

              </div>


              <div
                class="simple-card hardware-card active-combined"
                data-hardware="1"
              >

                <div class="card-top">

                  <span class="number">
                    03
                  </span>

                  <span class="small-tech">
                    Vibration
                  </span>

                </div>

                <h3>
                  Physical Disturbance
                </h3>

                <p>
                  Detects physical disturbance around
                  the monitored space.
                </p>

              </div>


              <div
                class="simple-card hardware-card"
                data-hardware="2"
              >

                <div class="card-top">

                  <span class="number">
                    04
                  </span>

                  <span class="small-tech">
                    ESP32-CAM
                  </span>

                </div>

                <h3>
                  Visual Check
                </h3>

                <p>
                  Provides a way to check what is
                  happening visually.
                </p>

              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- ===================================================
           DISTRIBUTED SYSTEM
      ==================================================== -->

      <section id="architecture" class="section">

        <div class="container">

          <div class="section-header centered">

            <div class="eyebrow-text">
              THE SYSTEM
            </div>

            <h2>
              Multiple sections.
              <span>One central brain.</span>
            </h2>

            <p>
              Each area manages its own devices,
              while the central system brings the
              information together.
            </p>

          </div>


          <div class="architecture-card">

            <div class="architecture-title">

              <span class="small-tech">
                HOW THE PARTS WORK TOGETHER
              </span>

              <h3>
                A distributed system built around synchronization.
              </h3>

              <p style="margin-top: 10px; color: #71717a; font-size: 13px; line-height: 1.6;">
                The most important part is keeping every section
                synchronized with the central system.
              </p>

            </div>


            <div class="architecture-diagram">

              <!-- SECTION 01 -->

              <div class="section-node">

                <div class="node-label">
                  LIVING ROOM (SECTION 01)
                </div>

                <div class="brain">

                  <div class="brain-symbol">
                    ●
                  </div>

                  <div>

                    <strong>
                      Section Brain
                    </strong>

                    <small>
                      Local controller
                    </small>

                  </div>

                </div>


                <div class="device-pills">

                  <span>Motion</span>
                  <span>Vibration</span>
                  <span>Camera</span>

                </div>

              </div>


              <div class="connection">

                <div class="connection-line"></div>

                <span>
                  information
                </span>

              </div>


              <!-- CENTRAL -->

              <div class="central-node">

                <div class="central-glow"></div>

                <div class="central-content">

                  <div class="node-label">
                    CENTRAL SYSTEM
                  </div>

                  <div class="central-symbol">
                    ✦
                  </div>

                  <strong>
                    Central Brain
                  </strong>

                  <small>
                    Brings everything together
                  </small>

                  <div class="central-tech">
                    MQTT · Node-RED
                  </div>

                </div>

              </div>


              <div class="connection reverse">

                <div class="connection-line"></div>

                <span>
                  information
                </span>

              </div>


              <!-- SECTION 02 -->

              <div class="section-node">

                <div class="node-label">
                  YARD (SECTION 02)
                </div>

                <div class="brain">

                  <div class="brain-symbol">
                    ●
                  </div>

                  <div>

                    <strong>
                      Section Brain
                    </strong>

                    <small>
                      Local controller
                    </small>

                  </div>

                </div>


                <div class="device-pills">

                  <span>Motion</span>
                  <span>Vibration</span>
                  <span>Camera</span>

                </div>

              </div>

            </div>


            <div class="architecture-bottom">

              <div>

                <strong>
                  Local devices
                </strong>

                <span>
                  Each area handles its own physical devices.
                </span>

              </div>


              <div>

                <strong>
                  Connected system
                </strong>

                <span>
                  Information is brought together centrally.
                </span>

              </div>


              <div>

                <strong>
                  One view
                </strong>

                <span>
                  The user can understand the system from one place.
                </span>

              </div>

            </div>

          </div>


          <div class="explanation-grid">

            <div class="explanation-card">

              <span class="step">
                STEP 01
              </span>

              <h3>
                Something happens.
              </h3>

              <p>
                A movement or physical disturbance
                happens in an area.
              </p>

            </div>


            <div class="explanation-card">

              <span class="step">
                STEP 02
              </span>

              <h3>
                The local brain notices.
              </h3>

              <p>
                The nearby device detects the event
                and passes the information on.
              </p>

            </div>


            <div class="explanation-card">

              <span class="step">
                STEP 03
              </span>

              <h3>
                The central system receives it.
              </h3>

              <p>
                Information from different areas
                can be handled together.
              </p>

            </div>


            <div class="explanation-card">

              <span class="step">
                STEP 04
              </span>

              <h3>
                The user sees it.
              </h3>

              <p>
                Useful information can finally
                reach the application.
              </p>

            </div>

          </div>

        </div>

      </section>


      <!-- ===================================================
           DATA
      ==================================================== -->

      <section class="section section-dark">

        <div class="container">

          <div class="section-header">

            <div class="eyebrow-text">
              FROM DATA TO INFORMATION
            </div>

            <h2>
              A signal becomes useful
              when the system can understand it.
            </h2>

          </div>


          <div class="data-flow-card">

            <div class="data-step">

              <div class="data-icon">
                01
              </div>

              <strong>
                Something happens
              </strong>

              <span>
                In the physical world
              </span>

            </div>


            <div class="data-arrow">
              →
            </div>


            <div class="data-step">

              <div class="data-icon">
                02
              </div>

              <strong>
                A device detects it
              </strong>

              <span>
                Information is collected
              </span>

            </div>


            <div class="data-arrow">
              →
            </div>


            <div class="data-step">

              <div class="data-icon">
                03
              </div>

              <strong>
                The system checks it
              </strong>

              <span>
                Information is processed
              </span>

            </div>


            <div class="data-arrow">
              →
            </div>


            <div class="data-step">

              <div class="data-icon">
                04
              </div>

              <strong>
                The user understands it
              </strong>

              <span>
                Information reaches the screen
              </span>

            </div>

          </div>

        </div>

      </section>


      <!-- ===================================================
           SECURITY
      ==================================================== -->

      <section id="security" class="section">

        <div class="container">

          <div class="section-header">

            <div class="eyebrow-text">
              SECURITY
            </div>

            <h2>
              Connected devices
              need protection too.
            </h2>

            <p>
              Because many devices are connected together,
              the system also needs to control who can
              communicate and what happens when something
              unusual occurs.
            </p>

          </div>


          <div class="security-grid">

            <div class="security-card featured-security">

              <div class="security-number">
                01
              </div>

              <div class="security-icon">
                ✓
              </div>

              <h3>
                Trusted Devices
              </h3>

              <p>
                Devices are checked before being allowed
                to participate in the system.
              </p>

              <span class="small-tech">
                Device Registry
              </span>

            </div>


            <div class="security-card">

              <div class="security-number">
                02
              </div>

              <h3>
                Controlled Access
              </h3>

              <p>
                Communication is limited so devices
                only access what they need.
              </p>

              <span class="small-tech">
                MQTT Access Control
              </span>

            </div>


            <div class="security-card">

              <div class="security-number">
                03
              </div>

              <h3>
                Unusual Activity
              </h3>

              <p>
                The system watches for unusually high
                communication activity.
              </p>

              <span class="small-tech">
                Activity Monitoring
              </span>

            </div>


            <div class="security-card">

              <div class="security-number">
                04
              </div>

              <h3>
                Controlled Pairing
              </h3>

              <p>
                New devices can be connected through
                a controlled pairing process.
              </p>

              <span class="small-tech">
                QR Pairing
              </span>

            </div>

          </div>

        </div>

      </section>


      <!-- ===================================================
           DEMO
      ==================================================== -->

      <!-- <section class="section section-dark">

        <div class="container">

          <div class="section-header centered">

            <div class="eyebrow-text">
              DEMONSTRATION
            </div>

            <h2>
              See it working.
            </h2>

            <p>
              From a physical event to information
              appearing on the user's screen.
            </p>

          </div>


          <div class="video-card">

            <div class="play-button">
              ▶
            </div>

            <h3>
              Project Demonstration
            </h3>

            <p>
              Replace this area with your project video.
            </p>

          </div>

        </div>

      </section>-->


      <!-- ===================================================
           DASHBOARD
      ==================================================== -->

      <section class="section">

        <div class="container">

          <div class="dashboard-layout">

            <div>

              <div class="eyebrow-text">
                THE APPLICATION
              </div>

              <h2>
                The screen is only
                the final piece.
              </h2>

              <p class="section-description">
                The dashboard gives the user a simple
                way to see what is happening across
                the connected system.
              </p>


              <div class="dashboard-features">

                <div class="dashboard-feature">

                  <span>01</span>

                  <div>

                    <strong>
                      System Status
                    </strong>

                    <p>
                      See which areas are active.
                    </p>

                  </div>

                </div>


                <div class="dashboard-feature">

                  <span>02</span>

                  <div>

                    <strong>
                      Alerts
                    </strong>

                    <p>
                      Know when something needs attention.
                    </p>

                  </div>

                </div>


                <div class="dashboard-feature">

                  <span>03</span>

                  <div>

                    <strong>
                      Remote Monitoring
                    </strong>

                    <p>
                      Check the system without being
                      physically there.
                    </p>

                  </div>

                </div>

              </div>

            </div>


            <!-- DASHBOARD CAROUSEL -->

            <div class="carousel dashboard-carousel" data-carousel>

              <div class="carousel-track">

                <div class="carousel-slide active">

                  <div class="image-box dashboard-image-box">

                    <img
                      src="/images/mainalert.png"
                      alt="Flutter dashboard"
                    />

                  </div>

                </div>


                <div class="carousel-slide">

                  <div class="image-box dashboard-image-box">

                    <img
                      src="/images/log.png"
                      alt="IoT monitoring dashboard"
                    />

                  </div>

                </div>


                <div class="carousel-slide">

                  <div class="image-box dashboard-image-box">

                    <img
                      src="/images/cyber.png"
                      alt="IoT alert dashboard"
                    />

                  </div>

                </div>

              </div>


              <div class="carousel-footer">

                <div class="carousel-counter">
                  <span data-current>01</span>
                  <span class="muted"> / 03</span>
                </div>

                <div class="carousel-buttons">

                  <button data-prev aria-label="Previous image">
                    ←
                  </button>

                  <button data-next aria-label="Next image">
                    →
                  </button>

                </div>

              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- ===================================================
           BEYOND SECURITY
      ==================================================== -->

      <section id="beyond" class="section section-dark">

        <div class="container">

          <div class="section-header centered">

            <div class="eyebrow-text">
              BEYOND SECURITY
            </div>

            <h2>
              Security is only
              <span>one use case.</span>
            </h2>

            <p>
              The bigger idea behind IoT is connecting
              the physical world with information.
            </p>

          </div>


          <div class="big-idea-card">

            <div class="big-idea-main">

              <span class="small-tech">
                THE BIGGER IDEA
              </span>

              <h3>
                What if the system
                wasn't looking for intruders?
              </h3>

              <p>
                The same approach could be used to
                understand an environment, study patterns
                and monitor changes over time.
              </p>

            </div>


            <div class="big-idea-flow">

              <div>
                <span>01</span>
                <strong>Sense</strong>
              </div>

              <div class="flow-line"></div>

              <div>
                <span>02</span>
                <strong>Connect</strong>
              </div>

              <div class="flow-line"></div>

              <div>
                <span>03</span>
                <strong>Analyse</strong>
              </div>

              <div class="flow-line"></div>

              <div>
                <span>04</span>
                <strong>Understand</strong>
              </div>

            </div>

          </div>


          <div class="application-grid">

            <div class="application-card">

              <div class="application-icon">
                ◌
              </div>

              <h3>
                Environment
              </h3>

              <p>
                Monitor things like temperature,
                movement or air conditions.
              </p>

              <span>
                Possible application
              </span>

            </div>


            <div class="application-card">

              <div class="application-icon">
                ≋
              </div>

              <h3>
                Patterns
              </h3>

              <p>
                Find repeated activity and changes
                that happen over time.
              </p>

              <span>
                Possible application
              </span>

            </div>


            <div class="application-card">

              <div class="application-icon">
                ◫
              </div>

              <h3>
                Operations
              </h3>

              <p>
                Keep track of equipment,
                spaces or processes.
              </p>

              <span>
                Possible application
              </span>

            </div>


            <div class="application-card">

              <div class="application-icon">
                ✦
              </div>

              <h3>
                Smart Decisions
              </h3>

              <p>
                Turn collected information
                into something useful.
              </p>

              <span>
                Possible application
              </span>

            </div>

          </div>


          <div class="beyond-statement">

            <div class="statement-line"></div>

            <p>
              The project was built for security,
              but the underlying IoT idea is much broader.
            </p>

            <div class="statement-line"></div>

          </div>

        </div>

      </section>


      <!-- ===================================================
           LEARNING
      ==================================================== -->

      <section class="section">

        <div class="container">

          <div class="section-header">

            <div class="eyebrow-text">
              WHAT I LEARNED
            </div>

            <h2>
              Building the system taught me
              more than just coding.
            </h2>

          </div>


          <div class="learning-grid">

            <div class="learning-card">

              <span>
                01
              </span>

              <h3>
                Hardware & Software
              </h3>

              <p>
                How physical devices and software
                can work together as one system.
              </p>

            </div>


            <div class="learning-card">

              <span>
                02
              </span>

              <h3>
                Connected Systems
              </h3>

              <p>
                How different parts can work
                independently while staying connected.
              </p>

            </div>


            <div class="learning-card">

              <span>
                03
              </span>

              <h3>
                Security
              </h3>

              <p>
                Why connected devices need protection
                at different points in the system.
              </p>

            </div>


            <div class="learning-card">

              <span>
                04
              </span>

              <h3>
                Problem Solving
              </h3>

              <p>
                Real hardware does not always behave
                as expected, so testing matters.
              </p>

            </div>

          </div>

        </div>

      </section>


      <!-- ===================================================
           ABOUT
      ==================================================== -->

      <section id="about" class="section final-section">

        <div class="container">

          <div class="final-card">

            <div class="final-glow"></div>

            <div class="final-content">

              <div class="eyebrow-text">
                ABOUT THE PROJECT
              </div>

              <h2>
                Building technology
                beyond the screen.
              </h2>

              <p>
                This project gave me the opportunity to work
                across hardware, software, networking and security,
                and connect them into one working system.
              </p>

              <p>
                I'm interested in building technology that
                connects software with real-world problems.
              </p>


              <div class="final-buttons">

