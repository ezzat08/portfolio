        margin-top: 35px;

        color: #60a5fa;

        font-size: 25px;

      }


      .security-card h3 {

        margin-top: 18px;

        font-size: 20px;

        font-weight: 500;

      }


      .security-card p {

        max-width: 450px;

        margin-top: 8px;

        color: #71717a;

        font-size: 13px;

        line-height: 1.7;

      }


      .security-card .small-tech {

        display: block;

        margin-top: 20px;

      }


      /* =====================================================
         VIDEO
      ====================================================== */

      .video-card {

        position: relative;

        display: flex;

        flex-direction: column;

        align-items: center;
        justify-content: center;

        min-height: 520px;

        overflow: hidden;

        border:
          1px solid rgba(255,255,255,0.07);

        border-radius: 30px;

        background:
          radial-gradient(
            circle at center,
            #202024,
            #09090b 70%
          );

        text-align: center;

      }


      .video-card::before {

        content: "";

        position: absolute;

        inset: 0;

        opacity: 0.25;

        background-image:
          linear-gradient(
            rgba(255,255,255,0.04) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255,255,255,0.04) 1px,
            transparent 1px
          );

        background-size: 45px 45px;

      }


      .play-button {

        position: relative;

        display: flex;

        align-items: center;
        justify-content: center;

        width: 75px;
        height: 75px;

        border:
          1px solid rgba(255,255,255,0.12);

        border-radius: 50%;

        background:
          rgba(255,255,255,0.05);

        font-size: 18px;

      }


      .video-card h3,
      .video-card p {

        position: relative;

      }


      .video-card h3 {

        margin-top: 25px;

        font-size: 20px;

        font-weight: 500;

      }


      .video-card p {

        margin-top: 7px;

        color: #52525b;

        font-size: 12px;

      }


      /* =====================================================
         DASHBOARD
      ====================================================== */

      .dashboard-layout {

        display: grid;

        grid-template-columns:
          0.8fr 1.2fr;

        gap: 80px;

        align-items: center;

      }


      .dashboard-features {

        margin-top: 35px;

      }


      .dashboard-feature {

        display: flex;

        gap: 18px;

        padding:
          18px 0;

        border-top:
          1px solid rgba(255,255,255,0.07);

      }


      .dashboard-feature > span {

        color: #52525b;

        font-size: 10px;

      }


      .dashboard-feature strong {

        font-size: 13px;

        font-weight: 500;

      }


      .dashboard-feature p {

        margin-top: 4px;

        color: #52525b;

        font-size: 11px;

      }


      .dashboard-carousel {

        border-radius: 25px;

      }


      /* =====================================================
         BEYOND SECURITY
      ====================================================== */

      .big-idea-card {

        display: grid;

        grid-template-columns:
          1fr 1fr;

        gap: 60px;

        padding: 45px;

        border:
          1px solid rgba(255,255,255,0.08);

        border-radius: 30px;

        background:
          radial-gradient(
            circle at 10% 0%,
            rgba(59,130,246,0.08),
            transparent 40%
          ),
          #18181b;

      }


      .big-idea-main h3 {

        max-width: 500px;

        margin-top: 15px;

        font-size:
          clamp(28px, 4vw, 45px);

        line-height: 1.05;

        letter-spacing:
          -0.04em;

        font-weight: 600;

      }


      .big-idea-main p {

        max-width: 520px;

        margin-top: 20px;

        color: #71717a;

        font-size: 14px;

        line-height: 1.75;

      }


      .big-idea-flow {

        display: flex;

        align-items: center;

        justify-content: center;

      }


      .big-idea-flow > div:not(.flow-line) {

        display: flex;

        flex-direction: column;

        gap: 8px;

        text-align: center;

      }


      .big-idea-flow span {

        color: #60a5fa;

        font-size: 9px;

      }


      .big-idea-flow strong {

        font-size: 11px;

        font-weight: 500;

      }


      .flow-line {

        width: 30px;

        height: 1px;

        margin: 0 7px;

        background:
          #3f3f46;

      }


      .application-grid {

        display: grid;

        grid-template-columns:
          repeat(4, 1fr);

        gap: 12px;

        margin-top: 15px;

      }


      .application-card {

        min-height: 230px;

        padding: 25px;

        border:
          1px solid rgba(255,255,255,0.07);

        border-radius: 22px;

        background: #111113;

      }


      .application-icon {

        color: #60a5fa;

        font-size: 23px;

      }


      .application-card h3 {

        margin-top: 45px;

        font-size: 16px;

        font-weight: 500;

      }


      .application-card p {

        margin-top: 7px;

        color: #71717a;

        font-size: 12px;

        line-height: 1.65;

      }


      .application-card > span {

        display: block;

        margin-top: 18px;

        color: #3f3f46;

        font-size: 9px;

        text-transform: uppercase;

        letter-spacing:
          0.1em;

      }


      .beyond-statement {

        display: flex;

        align-items: center;

        gap: 25px;

        margin-top: 80px;

      }


      .statement-line {

        flex: 1;

        height: 1px;

        background:
          rgba(255,255,255,0.06);

      }


      .beyond-statement p {

        max-width: 480px;

        margin: 0;

        color: #71717a;

        font-size: 13px;

        line-height: 1.6;

        text-align: center;

      }


      /* =====================================================
         LEARNING
      ====================================================== */

      .learning-grid {

        display: grid;

        grid-template-columns:
          repeat(4, 1fr);

        gap: 12px;

      }


      .learning-card {

        min-height: 250px;

        padding: 25px;

        border:
          1px solid rgba(255,255,255,0.07);

        border-radius: 22px;

        background: #18181b;

      }


      .learning-card > span {

        color: #52525b;

        font-size: 10px;

      }


      .learning-card h3 {

        margin-top: 55px;

        font-size: 17px;

        font-weight: 500;

      }


      .learning-card p {

        margin-top: 8px;

        color: #71717a;

        font-size: 12px;

        line-height: 1.65;

      }


      /* =====================================================
         FINAL
      ====================================================== */

      .final-section {

        padding-bottom: 100px;

      }


      .final-card {

        position: relative;

        overflow: hidden;

        padding: 90px 40px;

        border:
          1px solid rgba(255,255,255,0.08);

        border-radius: 35px;

        background:
          radial-gradient(
            circle at 50% 0%,
            rgba(59,130,246,0.1),
            transparent 45%
          ),
          #18181b;

        text-align: center;

      }


      .final-glow {

        position: absolute;

        width: 300px;
        height: 300px;

        left: 50%;
        top: 30%;

        transform:
          translate(-50%, -50%);

        border-radius: 50%;

        background:
          rgba(59,130,246,0.08);

        filter:
          blur(80px);

      }


      .final-content {

        position: relative;

        z-index: 1;

      }


      .final-content h2 {

        max-width: 700px;

        margin:
          16px auto 0;

        font-size:
          clamp(40px, 6vw, 68px);

        line-height: 1;

        letter-spacing:
          -0.05em;

      }


      .final-content p {

        max-width: 650px;

        margin:
          25px auto 0;

        color: #71717a;

        font-size: 15px;

        line-height: 1.75;

      }


      .final-buttons {

        display: flex;

        justify-content: center;

        flex-wrap: wrap;

        gap: 8px;

        margin-top: 32px;

      }


      .final-buttons .primary-button {
        margin-top: 0;
      }


      .secondary-button {

        display: inline-flex;

        align-items: center;

        padding:
          13px 19px;

        border:
          1px solid rgba(255,255,255,0.08);

        border-radius: 999px;

        color: #d4d4d8;

        font-size: 13px;

        text-decoration: none;

        background:
          rgba(255,255,255,0.03);

        transition:
          background 0.2s ease;

      }


      .secondary-button:hover {

        background:
          rgba(255,255,255,0.08);

      }


      /* =====================================================
         FOOTER
      ====================================================== */

      footer {

        border-top:
          1px solid rgba(255,255,255,0.06);

        padding:
          30px 0;

      }


      .footer-inner {

        display: flex;

        justify-content: space-between;

        gap: 20px;

        color: #3f3f46;

        font-size: 10px;

      }


      /* =====================================================
         RESPONSIVE
      ====================================================== */

      @media (max-width: 1000px) {

        .hero-inner {

          grid-template-columns:
            1fr;

          gap: 55px;

        }


        .hero-content {
          max-width: 700px;
        }


        .hardware-layout {

          grid-template-columns:
            1fr;

        }


        .architecture-diagram {

          grid-template-columns:
            1fr;

          gap: 15px;

        }


        .connection {

          transform:
            rotate(90deg);

        }


        .connection.reverse {

          transform:
            rotate(90deg);

        }


        .explanation-grid {

          grid-template-columns:
            1fr 1fr;

        }


        .dashboard-layout {

          grid-template-columns:
            1fr;

        }


        .big-idea-card {

          grid-template-columns:
            1fr;

        }


        .application-grid {

          grid-template-columns:
            1fr 1fr;

        }


        .learning-grid {

          grid-template-columns:
            1fr 1fr;

        }

      }


      @media (max-width: 700px) {

        .nav-links {
          display: none;
        }


        .container,
        .hero-inner {

          width:
            min(
              100% - 30px,
              1200px
            );

        }


        .section {

          padding:
            90px 0;

        }


        .hero-inner {

          padding-top:
            120px;

        }


        .hero h1 {

          font-size:
            clamp(50px, 15vw, 72px);

        }


        .three-cards {

          grid-template-columns:
            1fr;

        }


        .hardware-list {

          grid-template-columns:
            1fr;

        }


        .hardware-carousel {

          min-height: 400px;

        }


        .hardware-image-box {

          min-height: 400px;

        }


        .hardware-image-box img {

          padding: 20px;

        }


        .architecture-card {

          padding: 20px;

        }


        .architecture-bottom {

          grid-template-columns:
            1fr;

        }


        .explanation-grid {

          grid-template-columns:
            1fr;

        }


        .data-flow-card {

          grid-template-columns:
            1fr;

          gap: 10px;

        }


        .data-arrow {

          transform:
            rotate(90deg);

        }


        .security-grid {

          grid-template-columns:
            1fr;

        }


        .video-card {

          min-height: 350px;

        }


        .big-idea-card {

          padding: 28px;

        }


        .big-idea-flow {

          flex-wrap: wrap;

          gap: 12px;

        }


        .flow-line {

          width: 15px;

        }


        .application-grid {

          grid-template-columns:
            1fr;

        }


        .learning-grid {

          grid-template-columns:
            1fr;

        }


        .beyond-statement {

          margin-top: 50px;

        }


        .statement-line {

          display: none;

        }


        .footer-inner {

          flex-direction:
            column;

        }

      }

    </style>

  </body>
</html>
