  .timeline-description {
    max-width: 760px;
    margin: 0 0 25px;
    color: #c1b8ac;
    font-size: 14px;
    line-height: 1.7;
  }

  .section-light .timeline-description {
    color: #625a50;
  }

  .experience-points {
    display: grid;
    gap: 16px;
    margin-bottom: 25px;
  }

  .experience-point {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    align-items: start;
  }

  .experience-point span {
    padding-top: 2px;
    color: #9b7653;
    font-size: 10px;
    font-weight: 700;
  }

  .experience-point p {
    margin: 0;
    color: #b9b0a3;
    font-size: 12px;
    line-height: 1.65;
  }

  .section-light .experience-point p {
    color: #625a50;
  }

  .tech-tags,
  .skill-tags,
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .tech-tags span,
  .skill-tags span,
  .project-tags span {
    padding: 5px 9px;
    border: 1px solid rgba(185, 154, 119, 0.25);
    color: #b9b0a3;
    font-size: 10px;
    line-height: 1.2;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .tech-tags span:hover,
  .skill-tags span:hover,
  .project-tags span:hover {
    transform: translateY(-2px);
    border-color: rgba(185, 154, 119, 0.55);
    background: rgba(185, 154, 119, 0.08);
  }

  .section-light .tech-tags span,
  .section-light .skill-tags span {
    border-color: #d2c5b6;
    color: #665e53;
  }

  /* =========================
     LEADERSHIP
     ========================= */

  .leadership-timeline .timeline-content {
    padding-bottom: 5px;
  }

  .leadership-highlight {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 650px;
    margin: 25px 0;
    padding: 18px 20px;
    border-left: 2px solid #9b7653;
    background: rgba(155, 118, 83, 0.07);
    transition:
      transform 0.3s ease,
      background 0.3s ease;
  }

  .leadership-highlight:hover {
    transform: translateX(5px);
    background: rgba(155, 118, 83, 0.12);
  }

  .leadership-highlight span {
    color: #9b7653;
    font-size: 30px;
    line-height: 1;
    font-weight: 600;
  }

  .leadership-highlight p {
    margin: 0;
    color: #625a50;
    font-size: 13px;
    line-height: 1.55;
  }

  /* =========================
     EDUCATION
     ========================= */

  .education-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .education-card {
    position: relative;
    display: grid;
    grid-template-columns: 45px 1fr;
    gap: 25px;
    min-height: 280px;
    padding: 35px;
    overflow: hidden;
    border: 1px solid rgba(244, 239, 230, 0.15);
    background: #322e27;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .education-card:hover {
    transform: translateY(-7px);
    border-color: rgba(185, 154, 119, 0.5);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.15);
  }

  .education-number {
    position: relative;
    z-index: 2;
    color: #9b7653;
    font-size: 11px;
    font-weight: 700;
  }

  .education-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
  }

  .education-status {
    margin: 0 0 13px;
    color: #b99a77;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .education-content h3 {
    margin: 0 0 10px;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
  }

  .education-school {
    margin: 0;
    color: #b9b0a3;
    font-size: 13px;
  }

  .education-date {
    margin: 9px 0 0;
    color: #c8a984;
    font-size: 12px;
    font-weight: 600;
  }

  .education-bottom {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin-top: auto;
    padding-top: 25px;
    border-top: 1px solid rgba(244, 239, 230, 0.1);
    color: #91887b;
    font-size: 10px;
  }

  /* =========================
     SKILLS
     ========================= */

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: #d4c8b9;
    border: 1px solid #d4c8b9;
    perspective: 1200px;
  }

  .skill-card {
    position: relative;
    min-height: 320px;
    padding: 35px;
    overflow: hidden;
    background: #f4efe6;
    transform-style: preserve-3d;
    will-change: transform;
    transition:
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      background 0.3s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .skill-card:hover {
    background: #eee6da;
    box-shadow:
      0 22px 50px rgba(41, 37, 31, 0.12),
      0 0 35px rgba(155, 118, 83, 0.06);
  }

  .skill-card-glow {
    position: absolute;
    width: 280px;
    height: 280px;
    top: -150px;
    right: -110px;
    border-radius: 50%;
    background: rgba(155, 118, 83, 0.12);
    filter: blur(60px);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.5s ease,
      transform 1s ease;
  }

  .skill-card:hover .skill-card-glow,
  .skill-active .skill-card-glow {
    opacity: 1;
  }

  .skill-card:hover .skill-card-glow {
    transform: translate(-35px, 45px) scale(1.15);
  }

  .skill-scan {
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(155, 118, 83, 0.04) 48%,
      rgba(155, 118, 83, 0.12) 50%,
      rgba(155, 118, 83, 0.04) 52%,
      transparent 100%
    );
  }

  .skill-active .skill-scan {
    animation: skillScan 1.8s ease-out 0.2s 1;
  }

  @keyframes skillScan {
    from {
      top: -100%;
    }

    to {
      top: 100%;
    }
  }

  .skill-card-top {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
  }

  .skill-number {
    display: block;
    color: #9b7653;
    font-size: 11px;
    font-weight: 700;
  }

  .skill-category {
    color: #a08f7c;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.13em;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.6s ease 0.2s,
      transform 0.6s ease 0.2s;
  }

  .skill-active .skill-category {
    opacity: 1;
    transform: translateY(0);
  }

  .skill-icon-wrap {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 78px;
    height: 78px;
    margin-bottom: 25px;
    transform: translateZ(30px);
  }

  .skill-icon {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border: 1px solid #cdbba7;
    border-radius: 16px;
    background: #eee6da;
    color: #806344;
    font-family: monospace;
    font-size: 12px;
    font-weight: 700;
    box-shadow: 0 10px 25px rgba(41, 37, 31, 0.06);
    opacity: 0;
    transform: translateY(15px) scale(0.85) rotate(-5deg);
    transition:
      opacity 0.6s ease 0.25s,
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.25s,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .skill-active .skill-icon {
    opacity: 1;
    transform: translateY(0) scale(1) rotate(0deg);
  }

  .skill-card:hover .skill-icon {
    border-color: #9b7653;
    box-shadow:
      0 12px 30px rgba(41, 37, 31, 0.1),
      0 0 25px rgba(155, 118, 83, 0.1);
  }

  .skill-icon-ring {
    position: absolute;
    width: 76px;
    height: 76px;
    border: 1px dashed rgba(155, 118, 83, 0.3);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.7) rotate(-30deg);
  }

  .skill-active .skill-icon-ring {
    opacity: 1;
    transform: scale(1) rotate(0deg);
    animation:
      skillRingIn 0.8s ease 0.25s both,
      skillRingSpin 12s linear 1s infinite;
  }

  @keyframes skillRingIn {
    from {
      opacity: 0;
      transform: scale(0.7) rotate(-30deg);
    }

    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  @keyframes skillRingSpin {
    to {
      transform: rotate(360deg);
    }
  }

  .skill-icon-ring::before {
    content: "";
    position: absolute;
    top: -3px;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #9b7653;
    box-shadow: 0 0 10px rgba(155, 118, 83, 0.6);
  }

  .skill-content {
    position: relative;
    z-index: 3;
    transform: translateZ(20px);
  }

  .skill-card h3 {
    position: relative;
    z-index: 2;
    margin: 0 0 12px;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
    opacity: 0;
    transform: translateY(15px);
    transition:
      opacity 0.6s ease 0.35s,
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.35s;
  }

  .skill-active h3 {
    opacity: 1;
    transform: translateY(0);
  }

  .skill-card > p {
    position: relative;
    z-index: 2;
    max-width: 430px;
    margin: 0 0 25px;
    color: #625a50;
    font-size: 13px;
    line-height: 1.65;
    opacity: 0;
    transform: translateY(15px);
    transition:
      opacity 0.6s ease 0.45s,
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.45s;
  }

  .skill-active > p {
    opacity: 1;
    transform: translateY(0);
  }

  .skill-content > p {
    max-width: 430px;
    margin: 0 0 25px;
    color: #625a50;
    font-size: 13px;
    line-height: 1.65;
    opacity: 0;
    transform: translateY(15px);
    transition:
      opacity 0.6s ease 0.45s,
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.45s;
  }

  .skill-active .skill-content > p {
    opacity: 1;
    transform: translateY(0);
  }

  .skill-tags {
    position: relative;
    z-index: 3;
  }

  .skill-tags span {
    border-color: #d2c5b6;
    color: #665e53;
    opacity: 0;
    transform: translateY(14px) scale(0.92);
    transition:
      opacity 0.45s ease var(--tag-delay),
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) var(--tag-delay),
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .skill-tags span.skill-tag-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .skill-tags span:hover {
    transform: translateY(-3px) scale(1.02);
    border-color: #b99a77;
    background: rgba(185, 154, 119, 0.1);
  }

  .skill-line {
    position: absolute;
    left: 35px;
    right: 35px;
    bottom: 20px;
    width: auto;
    height: 1px;
    background: #d4c8b9;
    transform-origin: left;
  }

  .skill-line::after {
    content: "";
    display: block;
    width: 0;
    height: 1px;
    background: #9b7653;
    box-shadow: 0 0 8px rgba(155, 118, 83, 0.4);
    transition: width 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .skill-active .skill-line::after {
    width: 100%;
  }

  .skills-note {
    display: flex;
    align-items: baseline;
    gap: 25px;
    margin-top: 35px;
    padding-top: 25px;
    border-top: 1px solid #d4c8b9;
  }

  .skills-note > span {
    flex-shrink: 0;
    color: #806344;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .skills-note p {
    margin: 0;
    color: #625a50;
    font-size: 15px;
  }

  /* =========================
     PROJECTS
     ========================= */

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
  }

  .project-card {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid rgba(244, 239, 230, 0.14);
    background: #322e27;
    transform-style: preserve-3d;
    transition:
      transform 0.15s ease-out,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .project-card:hover {
    border-color: rgba(185, 154, 119, 0.45);
    box-shadow: 0 25px 55px rgba(0, 0, 0, 0.18);
  }

  .project-card.keyboard-focus {
    outline: 2px solid #9b7653;
    outline-offset: 5px;
  }

  .project-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #201d18;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.5s ease;
  }

  .project-card:hover .project-image img {
    transform: scale(1.06);
    filter: brightness(0.8);
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(41, 37, 31, 0.72);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .project-overlay {
    opacity: 1;
  }

  .project-overlay span {
    padding: 10px 15px;
    border: 1px solid rgba(244, 239, 230, 0.5);
    color: #f4efe6;
    font-size: 10px;
    font-weight: 600;
    transform: translateY(8px);
    transition: transform 0.3s ease;
  }

  .project-card:hover .project-overlay span {
    transform: translateY(0);
  }

  .project-info {
    position: relative;
    z-index: 2;
    padding: 28px;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
    color: #9b7653;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .project-info h3 {
    margin: 0 0 14px;
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -0.025em;
    font-weight: 600;
  }

  .project-info > p {
    margin: 0 0 22px;
    color: #b9b0a3;
    font-size: 13px;
    line-height: 1.7;
  }

  .project-tags span {
    border-color: rgba(185, 154, 119, 0.25);
    color: #b9b0a3;
  }

  /* =========================
     CONTACT
     ========================= */

  .contact-section {
    padding-bottom: 100px;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 100px;
    align-items: start;
  }

  .contact-heading h2 {
    max-width: 600px;
    margin: 0 0 25px;
    font-size: clamp(48px, 6vw, 78px);
    line-height: 0.98;
    letter-spacing: -0.06em;
    font-weight: 600;
  }

  .contact-heading h2 span {
    display: inline-block;
    margin-left: 0.12em;
    color: #9b7653;
  }

  .contact-heading > p:last-child {
    max-width: 540px;
    margin: 0;
    color: #625a50;
    font-size: 15px;
    line-height: 1.7;
  }

  .contact-card {
    border-top: 1px solid #cfc3b4;
  }

  .contact-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 22px 0;
    border-bottom: 1px solid #cfc3b4;
    transition:
      padding 0.25s ease,
      color 0.25s ease;
  }

  .contact-item:hover {
    padding-left: 10px;
    color: #9b7653;
  }

  .contact-label {
    display: block;
    margin-bottom: 5px;
    color: #806344;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .contact-item p {
    margin: 0;
    color: #40382f;
    font-size: 13px;
    transition: color 0.2s ease;
  }

  .contact-item:hover p {
    color: #9b7653;
  }

  .contact-arrow {
    font-size: 18px;
    transition:
      transform 0.25s ease,
      color 0.25s ease;
  }

  .contact-item:hover .contact-arrow {
    transform: translate(4px, -4px);
    color: #9b7653;
  }

  /* =========================
     FOOTER
     ========================= */

  .footer {
    background: #201d18;
    color: #8f877c;
  }

  .footer-container {
    width: min(1180px, calc(100% - 64px));
    min-height: 80px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    font-size: 10px;
  }

  /* =========================
     REVEAL ANIMATION
     ========================= */

  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.75s ease,
      transform 0.75s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /*
   * Skill cards use their own animation state.
   * This prevents the generic reveal animation from
   * fighting with the 3D skill-card transform.
   */

  .skill-animated-card.reveal {
    opacity: 0;
    transform:
      translateY(65px)
      scale(0.94)
      rotateX(7deg);
    transition:
      opacity 0.8s ease,
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .skill-animated-card.reveal.visible {
    opacity: 1;
    transform:
      translateY(0)
      scale(1)
      rotateX(0deg);
  }

  .skill-animated-card:nth-child(2).reveal {
    transition-delay: 0.08s;
  }

  .skill-animated-card:nth-child(3).reveal {
    transition-delay: 0.16s;
  }

  .skill-animated-card:nth-child(4).reveal {
    transition-delay: 0.24s;
  }

  .timeline-item:nth-child(2).reveal {
    transition-delay: 0.08s;
  }

  .timeline-item:nth-child(3).reveal {
    transition-delay: 0.16s;
  }

  .project-card:nth-child(2).reveal {
    transition-delay: 0.1s;
  }

  /* =========================
     HERO ANIMATIONS
     ========================= */

  @keyframes heroFade {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroTitle {
    from {
      opacity: 0;
      transform: translateY(35px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroPhoto {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.97);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes slowFloat {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }

    50% {
      transform: translateY(-18px) rotate(3deg);
    }
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(118, 140, 104, 0.45);
    }

    70% {
      box-shadow: 0 0 0 8px rgba(118, 140, 104, 0);
    }

    100% {
      box-shadow: 0 0 0 0 rgba(118, 140, 104, 0);
    }
  }

  @keyframes scrollHint {
    0%,
    100% {
      opacity: 0.55;
      transform: translate(-50%, 0);
    }

    50% {
      opacity: 1;
      transform: translate(-50%, 5px);
    }
  }

  /* =========================
     RESPONSIVE
     ========================= */

  @media (max-width: 1000px) {
    .nav-links {
      gap: 17px;
    }

    .hero-container {
      gap: 60px;
    }

    .contact-layout {
      gap: 60px;
    }

    .cursor-glow {
      display: none;
    }
  }

  @media (max-width: 750px) {
    .section {
      padding: 90px 0;
    }

    .section-container,
    .nav-container,
    .hero-container,
    .footer-container {
      width: min(100% - 40px, 600px);
    }

    .nav-links {
      display: none;
    }

    .hero {
      min-height: auto;
      padding: 140px 0 110px;
    }

    .hero-container {
      grid-template-columns: 1fr;
      gap: 55px;
    }

    .hero-photo {
      justify-self: start;
      width: min(350px, 100%);
    }

    .hero-title {
      font-size: clamp(52px, 14vw, 75px);
    }

    .section-heading {
      margin-bottom: 50px;
    }

    .timeline-top {
      flex-direction: column;
      gap: 8px;
    }

    .timeline-date {
      white-space: normal;
    }

    .education-grid,
    .skills-grid,
    .projects-grid,
    .contact-layout {
      grid-template-columns: 1fr;
    }

    .contact-layout {
      gap: 60px;
    }

    .skills-note {
      flex-direction: column;
      gap: 10px;
    }

    .scroll-hint {
      display: none;
    }

    .skill-card {
